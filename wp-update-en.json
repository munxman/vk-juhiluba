{"id": 33182, "content": "<!-- wp:html -->\n<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n <meta charset=\"UTF-8\">\n <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n <meta name=\"robots\" content=\"noindex,nofollow\">\n <title>Driving Licence Medical Certificate Same Day | Valvekliinik Tallinn</title>\n <meta name=\"description\" content=\"Driver's medical certificate in Tallinn \u2013 same day, no referral needed. Driving licence health check from \u20ac65. Valvekliinik, \u00dclemiste City.\">\n\n <!-- Open Graph -->\n <meta property=\"og:type\" content=\"website\">\n <meta property=\"og:url\" content=\"https://valvekliinik.ee/juhiluba/en/\">\n <meta property=\"og:title\" content=\"Driving Licence Medical Certificate Same Day | Valvekliinik Tallinn\">\n <meta property=\"og:description\" content=\"Driver's medical certificate in Tallinn \u2013 same day. From \u20ac65. No referral needed. Book online.\">\n <meta property=\"og:site_name\" content=\"Valvekliinik\">\n\n <!-- Fonts -->\n <link rel=\"preconnect\" href=\"https://fonts.googleapis.com\">\n <link rel=\"preconnect\" href=\"https://fonts.gstatic.com\" crossorigin>\n <link href=\"https://fonts.googleapis.com/css2?family=Poppins:wght@400;600&display=swap\" rel=\"stylesheet\">\n\n <style>\n  :root {\n   --paper: #F4F1EA;\n   --vein: #5E262C;\n   --tellis: #98544E;\n   --roosa: #E6D3CE;\n   --kivi: #C4BBAE;\n   --ink: #1A1A1A;\n   --white: #FFFFFF;\n   --font: 'Poppins', system-ui, -apple-system, sans-serif;\n  }\n\n  * { margin: 0; padding: 0; box-sizing: border-box; }\n  html { font-size: 18px; scroll-behavior: smooth; }\n  body { font-family: var(--font); color: var(--ink); background: var(--paper); line-height: 1.65; }\n  a { color: var(--vein); text-decoration: none; }\n  a:hover { text-decoration: underline; }\n\n  .container { max-width: 940px; margin: 0 auto; padding: 0 24px; }\n\n  /* Top bar */\n  .top-bar {\n   background: var(--ink);\n   color: rgba(255,255,255,0.6);\n   font-size: 0.76rem;\n   padding: 9px 0;\n   text-align: center;\n  }\n  .top-bar a { color: #ffffff; font-weight: 600; }\n  .top-bar .sep { margin: 0 8px; opacity: 0.35; }\n\n  /* Header */\n  .site-header {\n   background: var(--white);\n   border-bottom: 1px solid var(--kivi);\n   padding: 14px 0;\n   position: sticky;\n   top: 0;\n   z-index: 200;\n  }\n  .site-header .container {\n   display: flex;\n   align-items: center;\n   justify-content: space-between;\n   gap: 16px;\n  }\n  .logo-link { display: flex; align-items: center; gap: 10px; text-decoration: none; }\n  .logo-link img { height: 52px; display: block; }\n  .header-nav { display: flex; align-items: center; gap: 20px; }\n  .header-phone { font-weight: 600; font-size: 0.88rem; color: var(--ink); }\n  .btn-primary {\n   display: inline-block;\n   background: var(--vein);\n   color: #ffffff;\n   padding: 10px 24px;\n   border-radius: 6px;\n   font-weight: 600;\n   font-size: 0.85rem;\n   text-decoration: none;\n   transition: background 0.18s;\n   white-space: nowrap;\n  }\n  .btn-primary:hover { background: var(--tellis); text-decoration: none; }\n\n  /* Hero */\n  .hero {\n   background: var(--white);\n   padding: 68px 0 54px;\n   border-bottom: 1px solid var(--kivi);\n   text-align: center;\n  }\n  .overline {\n   display: inline-block;\n   font-size: 0.68rem;\n   font-weight: 600;\n   letter-spacing: 0.13em;\n   text-transform: uppercase;\n   color: var(--tellis);\n   margin-bottom: 18px;\n  }\n  .hero h1 {\n   font-size: clamp(1.85rem, 4.5vw, 2.75rem);\n   font-weight: 600;\n   line-height: 1.15;\n   margin-bottom: 18px;\n   letter-spacing: -0.02em;\n  }\n  .hero h1 em {\n   font-style: normal;\n   color: var(--vein);\n  }\n  .hero .lead {\n   font-size: 1.05rem;\n   color: var(--tellis);\n   max-width: 500px;\n   margin: 0 auto 30px;\n  }\n  .hero-price-row {\n   margin-bottom: 30px;\n  }\n  .hero-price {\n   font-size: 2.5rem;\n   font-weight: 600;\n   color: var(--ink);\n   line-height: 1;\n   margin-bottom: 6px;\n  }\n  .hero-price-note {\n   font-size: 0.95rem;\n   color: var(--ink);\n   font-weight: 600;\n  }\n  .btn-hero {\n   display: inline-block;\n   background: var(--vein);\n   color: #ffffff;\n   padding: 15px 42px;\n   border-radius: 6px;\n   font-weight: 600;\n   font-size: 1rem;\n   text-decoration: none;\n   transition: all 0.18s;\n  }\n  .btn-hero:hover { background: var(--tellis); transform: translateY(-1px); text-decoration: none; }\n  .hero-sub {\n   margin-top: 14px;\n   font-size: 0.82rem;\n   color: var(--kivi);\n  }\n  .hero-sub a { color: var(--vein); font-weight: 600; }\n\n  /* USP strip */\n  .usp-strip {\n   background: var(--ink);\n   padding: 20px 0;\n  }\n  .usp-grid {\n   display: grid;\n   grid-template-columns: repeat(4, 1fr);\n   gap: 8px;\n   text-align: center;\n  }\n  .usp-item { padding: 8px; }\n  .usp-icon { font-size: 1.25rem; margin-bottom: 4px; }\n  .usp-label { font-size: 0.78rem; font-weight: 600; color: #ffffff; }\n\n  /* Generic section */\n  .section { padding: 56px 0; }\n  .section-white { background: var(--white); }\n  .section-paper { background: var(--paper); }\n  .section-title {\n   font-size: 1.55rem;\n   font-weight: 600;\n   letter-spacing: -0.02em;\n   margin-bottom: 10px;\n   text-align: center;\n  }\n  .section-lead {\n   text-align: center;\n   color: var(--tellis);\n   font-size: 0.9rem;\n   margin-bottom: 40px;\n  }\n  .section-head {\n   text-align: center;\n   margin-bottom: 40px;\n  }\n  .section-head .overline { display: block; }\n\n  /* Exam checks */\n  .exam-grid {\n   display: grid;\n   grid-template-columns: repeat(5, 1fr);\n   gap: 14px;\n  }\n  .exam-card {\n   background: var(--white);\n   border: 1px solid var(--kivi);\n   border-radius: 10px;\n   padding: 20px 14px;\n   text-align: center;\n  }\n  .exam-card .exam-icon { font-size: 1.5rem; margin-bottom: 10px; }\n  .exam-card .exam-name { font-size: 0.8rem; font-weight: 600; color: var(--ink); line-height: 1.3; }\n\n  /* Categories table */\n  .cat-table-wrap {\n   overflow-x: auto;\n   border-radius: 10px;\n   border: 1px solid var(--kivi);\n   background: var(--white);\n  }\n  .cat-table {\n   width: 100%;\n   border-collapse: collapse;\n   font-size: 0.88rem;\n  }\n  .cat-table th {\n   background: var(--vein);\n   color: #ffffff;\n   padding: 13px 18px;\n   text-align: left;\n   font-weight: 600;\n   font-size: 0.8rem;\n   letter-spacing: 0.04em;\n  }\n  .cat-table td {\n   padding: 13px 18px;\n   border-bottom: 1px solid var(--roosa);\n   color: var(--ink);\n  }\n  .cat-table tr:last-child td { border-bottom: none; }\n  .cat-table tr:nth-child(even) td { background: #faf8f4; }\n  .cat-badge {\n   display: inline-block;\n   background: var(--roosa);\n   color: var(--vein);\n   border-radius: 4px;\n   padding: 2px 8px;\n   font-size: 0.78rem;\n   font-weight: 600;\n  }\n  .notice-box {\n   background: var(--roosa);\n   border-left: 3px solid var(--tellis);\n   border-radius: 0 8px 8px 0;\n   padding: 14px 18px;\n   font-size: 0.85rem;\n   color: var(--ink);\n   margin-top: 16px;\n  }\n  .notice-box a { color: var(--vein); font-weight: 600; }\n\n  /* Steps */\n  .steps-list {\n   display: flex;\n   flex-direction: column;\n   gap: 0;\n   max-width: 640px;\n   margin: 0 auto;\n  }\n  .step-row {\n   display: flex;\n   gap: 20px;\n   align-items: flex-start;\n   position: relative;\n   padding-bottom: 30px;\n  }\n  .step-row:last-child { padding-bottom: 0; }\n  .step-row:not(:last-child)::after {\n   content: '';\n   position: absolute;\n   left: 20px;\n   top: 44px;\n   bottom: 0;\n   width: 2px;\n   background: var(--roosa);\n  }\n  .step-num {\n   flex-shrink: 0;\n   width: 42px;\n   height: 42px;\n   border-radius: 50%;\n   background: var(--vein);\n   color: #ffffff;\n   font-weight: 600;\n   font-size: 1rem;\n   display: flex;\n   align-items: center;\n   justify-content: center;\n   position: relative;\n   z-index: 1;\n  }\n  .step-body { padding-top: 8px; }\n  .step-body h3 { font-size: 0.95rem; font-weight: 600; margin-bottom: 6px; color: var(--ink); }\n  .step-body p { font-size: 0.85rem; color: var(--tellis); line-height: 1.6; }\n  .step-body a { color: var(--vein); font-weight: 600; }\n  .step-body .step-tag {\n   display: inline-block;\n   font-size: 0.72rem;\n   font-weight: 600;\n   background: var(--roosa);\n   color: var(--vein);\n   border-radius: 4px;\n   padding: 2px 8px;\n   margin-bottom: 8px;\n   text-transform: uppercase;\n   letter-spacing: 0.06em;\n  }\n\n  /* Bring list */\n  .bring-cols {\n   display: grid;\n   grid-template-columns: 1fr 1fr;\n   gap: 40px;\n   align-items: start;\n  }\n  .bring-list {\n   list-style: none;\n  }\n  .bring-list li {\n   display: flex;\n   align-items: flex-start;\n   gap: 12px;\n   padding: 12px 0;\n   border-bottom: 1px solid var(--kivi);\n   font-size: 0.88rem;\n   color: var(--ink);\n  }\n  .bring-list li:last-child { border-bottom: none; }\n  .check-mark {\n   color: var(--vein);\n   font-weight: 600;\n   flex-shrink: 0;\n   line-height: 1.65;\n  }\n  .info-panel {\n   background: var(--roosa);\n   border-radius: 12px;\n   padding: 26px 22px;\n  }\n  .info-panel h3 {\n   font-size: 0.95rem;\n   font-weight: 600;\n   margin-bottom: 14px;\n   color: var(--ink);\n  }\n  .info-panel p {\n   font-size: 0.85rem;\n   color: var(--tellis);\n   margin-bottom: 10px;\n   line-height: 1.6;\n  }\n  .info-panel p:last-child { margin-bottom: 0; }\n  .info-panel a { color: var(--vein); font-weight: 600; }\n\n  /* Pricing */\n  .price-cards {\n   display: grid;\n   grid-template-columns: repeat(2, 1fr);\n   gap: 24px;\n   max-width: 640px;\n   margin: 0 auto;\n  }\n  .price-card {\n   background: var(--white);\n   border: 2px solid var(--kivi);\n   border-radius: 12px;\n   padding: 30px 22px;\n   text-align: center;\n   transition: border-color 0.18s;\n  }\n  .price-card:hover { border-color: var(--vein); }\n  .price-card h3 { font-size: 1rem; font-weight: 600; margin-bottom: 4px; }\n  .price-card .cat-list { font-size: 0.8rem; color: var(--kivi); margin-bottom: 16px; }\n  .price-amount { font-size: 2.1rem; font-weight: 600; color: var(--vein); line-height: 1; margin-bottom: 12px; }\n  .price-includes { font-size: 0.78rem; color: var(--tellis); line-height: 1.55; }\n\n  /* Booking widget */\n  .booking-section { background: var(--paper); padding: 56px 0; }\n  .booking-intro {\n   text-align: center;\n   margin-bottom: 28px;\n  }\n  .booking-note {\n   background: var(--roosa);\n   border-radius: 8px;\n   padding: 14px 20px;\n   font-size: 0.84rem;\n   color: var(--ink);\n   text-align: center;\n   margin-bottom: 20px;\n  }\n  .booking-note strong { color: var(--vein); }\n  .booking-widget-wrap {\n   background: var(--white);\n   border-radius: 12px;\n   border: 1px solid var(--kivi);\n   overflow: hidden;\n  }\n  .booking-widget-wrap iframe {\n   display: block;\n   width: 100%;\n   height: 620px;\n   border: none;\n  }\n\n  /* FAQ */\n  .faq-list {\n   max-width: 680px;\n   margin: 0 auto;\n  }\n  .faq-item {\n   background: var(--white);\n   border: 1px solid var(--kivi);\n   border-radius: 10px;\n   margin-bottom: 10px;\n   overflow: hidden;\n  }\n  .faq-item summary {\n   padding: 17px 20px;\n   font-weight: 600;\n   font-size: 0.88rem;\n   cursor: pointer;\n   list-style: none;\n   display: flex;\n   justify-content: space-between;\n   align-items: center;\n   color: var(--ink);\n   gap: 12px;\n  }\n  .faq-item summary::-webkit-details-marker { display: none; }\n  .faq-icon {\n   flex-shrink: 0;\n   width: 22px;\n   height: 22px;\n   border-radius: 50%;\n   background: var(--roosa);\n   color: var(--vein);\n   font-size: 1rem;\n   display: flex;\n   align-items: center;\n   justify-content: center;\n   font-weight: 400;\n   line-height: 1;\n  }\n  .faq-item[open] .faq-icon::before { content: '-'; }\n  .faq-icon::before { content: '+'; }\n  .faq-body {\n   padding: 0 20px 18px;\n   font-size: 0.84rem;\n   color: var(--tellis);\n   line-height: 1.7;\n  }\n  .faq-body a { color: var(--vein); font-weight: 600; }\n\n  /* CTA bottom */\n  .cta-bottom {\n   background: var(--vein);\n   color: #ffffff;\n   padding: 56px 0;\n   text-align: center;\n  }\n  .cta-bottom h2 { font-size: 1.6rem; font-weight: 600; margin-bottom: 10px; }\n  .cta-bottom p { font-size: 0.95rem; opacity: 0.85; margin-bottom: 26px; }\n  .btn-white {\n   display: inline-block;\n   background: #ffffff;\n   color: var(--vein);\n   padding: 14px 36px;\n   border-radius: 6px;\n   font-weight: 600;\n   font-size: 0.95rem;\n   text-decoration: none;\n   transition: transform 0.18s;\n  }\n  .btn-white:hover { transform: translateY(-1px); text-decoration: none; }\n\n  /* Footer */\n  .site-footer {\n   background: var(--ink);\n   color: rgba(255,255,255,0.5);\n   padding: 32px 0;\n   font-size: 0.8rem;\n  }\n  .footer-inner {\n   display: flex;\n   justify-content: space-between;\n   align-items: flex-start;\n   gap: 24px;\n   flex-wrap: wrap;\n  }\n  .footer-col strong { color: #ffffff; display: block; margin-bottom: 6px; }\n  .footer-col a { color: rgba(255,255,255,0.7); }\n  .footer-col a:hover { color: #ffffff; text-decoration: underline; }\n  .footer-line { margin-bottom: 4px; }\n\n  /* Divider */\n  .divider { border: none; border-top: 1px solid var(--kivi); margin: 0; }\n\n  /* Mobile */\n  @media (max-width: 768px) {\n   .header-phone { display: none; }\n   .hero { padding: 44px 0 36px; }\n   .usp-grid { grid-template-columns: repeat(2, 1fr); }\n   .exam-grid { grid-template-columns: repeat(3, 1fr); }\n   .bring-cols { grid-template-columns: 1fr; gap: 24px; }\n   .price-cards { grid-template-columns: 1fr; }\n   .footer-inner { flex-direction: column; gap: 16px; }\n   .booking-widget-wrap iframe { height: 520px; }\n  }\n  @media (max-width: 480px) {\n   .exam-grid { grid-template-columns: repeat(2, 1fr); }\n   .cat-table th, .cat-table td { padding: 10px 12px; font-size: 0.8rem; }\n  }\n </style>\n</head>\n<body>\n\n<!-- Top info bar -->\n<div class=\"top-bar\">\n <span>Mon\u2013Fri 9:00\u201318:00</span>\n <span class=\"sep\">\u00b7</span>\n <span>Sat 12:00\u201316:00</span>\n <span class=\"sep\">\u00b7</span>\n <span>Public holidays 12:00\u201316:00</span>\n <span class=\"sep\">\u00b7</span>\n <a href=\"tel:+37259110909\">+372 5911 0909</a>\n</div>\n\n<!-- Header -->\n<header class=\"site-header\">\n <div class=\"container\">\n  <a href=\"https://valvekliinik.ee\" class=\"logo-link\">\n   <img src=\"https://valvekliinik.ee/wp-content/uploads/2021/08/vk-logo.svg\" alt=\"Valvekliinik\">\n  </a>\n  <nav class=\"header-nav\">\n   <a href=\"tel:+37259110909\" class=\"header-phone\">+372 5911 0909</a>\n   <a href=\"#book\" class=\"btn-primary\">Book an appointment</a>\n  </nav>\n </div>\n</header>\n\n<!-- Hero -->\n<section class=\"hero\">\n <div class=\"container\">\n  <span class=\"overline\">Same day \u2013 including Saturdays and public holidays</span>\n  <h1>Driving licence medical certificate<br><em>fast and hassle-free</em></h1>\n  <p class=\"lead\">Health check and certificate issued in one short visit. The certificate is sent to the Transport Administration automatically*.</p>\n  <div class=\"hero-price-row\">\n   <div class=\"hero-price\">from \u20ac65</div>\n   <div class=\"hero-price-note\">Categories A, B, AM, T and their sub-categories</div>\n  </div>\n  <a href=\"#book\" class=\"btn-hero\">Book an appointment</a>\n  <p class=\"hero-sub\">Or call <a href=\"tel:+37259110909\">+372 5911 0909</a></p>\n </div>\n</section>\n\n<!-- USP strip -->\n<div class=\"usp-strip\">\n <div class=\"container\">\n  <div class=\"usp-grid\">\n   <div class=\"usp-item\">\n    <div class=\"usp-label\" style=\"font-weight:600;\">Approx. 20\u201330 minutes</div>\n   </div>\n   <div class=\"usp-item\">\n    <div class=\"usp-icon\"></div>\n    <div class=\"usp-label\">Same day</div>\n   </div>\n   <div class=\"usp-item\">\n    <div class=\"usp-icon\"></div>\n    <div class=\"usp-label\">No referral needed</div>\n   </div>\n   <div class=\"usp-item\">\n    <div class=\"usp-label\" style=\"font-weight:600;\">\u00dclemiste City, Tallinn</div>\n   </div>\n  </div>\n </div>\n</div>\n\n<!-- What is checked -->\n<section class=\"section section-white\">\n <div class=\"container\">\n  <div class=\"section-head\">\n   <span class=\"overline\">Health check</span>\n   <h2 class=\"section-title\">What is examined?</h2>\n   <p class=\"section-lead\">The driving licence health check is brief and comprehensive.</p>\n  </div>\n  <div class=\"exam-grid\">\n   <div class=\"exam-card\">\n    <div class=\"exam-icon\"></div>\n    <div class=\"exam-name\">Blood pressure</div>\n   </div>\n   <div class=\"exam-card\">\n    <div class=\"exam-icon\"></div>\n    <div class=\"exam-name\">Vision</div>\n   </div>\n   <div class=\"exam-card\">\n    <div class=\"exam-icon\"></div>\n    <div class=\"exam-name\">Body mass index (weight and height)</div>\n   </div>\n   <div class=\"exam-card\">\n    <div class=\"exam-icon\"></div>\n    <div class=\"exam-name\">Neck circumference</div>\n   </div>\n   <div class=\"exam-card\">\n    <div class=\"exam-icon\"></div>\n    <div class=\"exam-name\">Blood glucose</div>\n   </div>\n  </div>\n </div>\n</section>\n\n<hr class=\"divider\">\n\n<!-- Driving license categories -->\n<section class=\"section section-white\">\n <div class=\"container\">\n  <div class=\"section-head\">\n   <span class=\"overline\">Transport Administration requirements</span>\n   <h2 class=\"section-title\">Categories and validity periods</h2>\n   <p class=\"section-lead\">The certificate's validity period depends on the licence category and your age.</p>\n  </div>\n  <div class=\"cat-table-wrap\">\n   <table class=\"cat-table\">\n    <thead>\n     <tr>\n      <th>Category</th>\n      <th>Examples</th>\n      <th>Validity (under 65)</th>\n      <th>Validity (65 and over)</th>\n     </tr>\n    </thead>\n    <tbody>\n     <tr>\n      <td><span class=\"cat-badge\">Category I</span></td>\n      <td>A, B, AM, T and sub-categories</td>\n      <td>Every 10 years</td>\n      <td>Every 5 years</td>\n     </tr>\n     <tr>\n      <td><span class=\"cat-badge\">Category II</span></td>\n      <td>C, D, E and sub-categories</td>\n      <td>Every 5 years</td>\n      <td>Every 5 years</td>\n     </tr>\n    </tbody>\n   </table>\n  </div>\n  <div class=\"notice-box\">\n   Drivers aged 65 and over must renew the medical certificate every 5 years, regardless of category.\n   More information: <a href=\"https://transpordiamet.ee/tervisetoend-autojuhile\" target=\"_blank\" rel=\"noopener noreferrer\">transpordiamet.ee/tervisetoend-autojuhile</a>\n  </div>\n </div>\n</section>\n\n<!-- Steps -->\n<section class=\"section section-paper\">\n <div class=\"container\">\n  <div class=\"section-head\">\n   <span class=\"overline\">How it works</span>\n   <h2 class=\"section-title\">Three steps to your certificate</h2>\n   <p class=\"section-lead\">The process is simple and quick.</p>\n  </div>\n  <div class=\"steps-list\">\n   <div class=\"step-row\">\n    <div class=\"step-num\">1</div>\n    <div class=\"step-body\">\n     <span class=\"step-tag\">Before your visit</span>\n     <h3>We recommend completing the health declaration</h3>\n     <p>Go to <a href=\"https://www.terviseportaal.ee/\" target=\"_blank\" rel=\"noopener noreferrer\">terviseportaal.ee</a> and complete the health declaration using Smart-ID or your ID card. This is the mandatory first step for the e-health certificate application and must be done before your appointment.</p>\n    </div>\n   </div>\n   <div class=\"step-row\">\n    <div class=\"step-num\">2</div>\n    <div class=\"step-body\">\n     <span class=\"step-tag\">Visit</span>\n     <h3>Come in for your health check</h3>\n     <p>The health check takes approximately 20\u201330 minutes. We measure blood pressure, vision, weight, height, neck circumference and blood glucose. Bring a valid identity document and your glasses (if you wear them). Come on an empty stomach \u2013 no food for at least 2 hours before the appointment (water is fine).</p>\n    </div>\n   </div>\n   <div class=\"step-row\">\n    <div class=\"step-num\">3</div>\n    <div class=\"step-body\">\n     <span class=\"step-tag\">Certificate</span>\n     <h3>Certificate is sent automatically to the Transport Administration</h3>\n     <p>The certificate is issued digitally and sent automatically to the vehicle register. No paperwork needed \u2013 everything is handled electronically. The certificate is valid immediately upon issue.</p>\n    </div>\n   </div>\n  </div>\n </div>\n</section>\n\n<!-- Bring + exam info -->\n<section class=\"section section-white\">\n <div class=\"container\">\n  <div class=\"section-head\">\n   <span class=\"overline\">Preparation</span>\n   <h2 class=\"section-title\">What to bring?</h2>\n  </div>\n  <div class=\"bring-cols\">\n   <ul class=\"bring-list\">\n    <li>\n     <span class=\"check-mark\"></span>\n     <span>A valid identity document (ID card or passport)</span>\n    </li>\n    <li>\n     <span class=\"check-mark\"></span>\n     <span>Glasses or contact lenses if you wear them \u2013 the vision check is performed with them on</span>\n    </li>\n    <li>\n     <span class=\"check-mark\"></span>\n     <span>Preferably a completed health declaration via <a href=\"https://www.terviseportaal.ee/\" target=\"_blank\" rel=\"noopener noreferrer\">terviseportaal.ee</a> (can also be completed at the clinic)</span>\n    </li>\n    <li>\n     <span class=\"check-mark\"></span>\n     <span>Come on an empty stomach \u2013 no food for at least 2 hours before your appointment (water is fine)</span>\n    </li>\n   </ul>\n   <div class=\"info-panel\">\n    <h3>Good to know</h3>\n    <p>The health declaration must be completed in advance via <a href=\"https://www.terviseportaal.ee/\" target=\"_blank\" rel=\"noopener noreferrer\">terviseportaal.ee</a> (it can also be filled in at the clinic). A certificate cannot be issued without a completed declaration.</p>\n    <p>If no health issues are found during the check, the certificate is issued the same day.</p>\n    <p>The certificate is sent to the Transport Administration digitally \u2013 no paper or separate submission is required.</p>\n    <p>More information: <a href=\"https://transpordiamet.ee/tervisetoend-autojuhile\" target=\"_blank\" rel=\"noopener noreferrer\">transpordiamet.ee</a></p>\n   </div>\n  </div>\n </div>\n</section>\n\n<!-- Pricing -->\n<section class=\"section section-paper\">\n <div class=\"container\">\n  <div class=\"section-head\">\n   <span class=\"overline\">Prices</span>\n   <h2 class=\"section-title\">Transparent pricing, no hidden fees</h2>\n   <p class=\"section-lead\">Health check and certificate included in one price.</p>\n  </div>\n  <div class=\"price-cards\">\n   <div class=\"price-card\">\n    <h3>Category I</h3>\n    <div class=\"cat-list\">Categories A, B, AM, T<br>and their sub-categories</div>\n    <div class=\"price-amount\">\u20ac65</div>\n    <div class=\"price-includes\">\n     Health check + certificate issuance.<br>\n     Standard car, motorcycle, moped, tractor.\n    </div>\n   </div>\n   <div class=\"price-card\">\n    <h3>Category II</h3>\n    <div class=\"cat-list\">Categories C, D, E<br>and their sub-categories</div>\n    <div class=\"price-amount\">\u20ac90</div>\n    <div class=\"price-includes\">\n     Extended health check + certificate issuance.<br>\n     Lorry, bus, trailer \u2013 professional licence categories.\n    </div>\n   </div>\n  </div>\n </div>\n</section>\n\n  <p style=\"font-size:.85rem;color:var(--tellis);margin-top:2rem;margin-bottom:2rem;text-align:center;max-width:660px;margin-left:auto;margin-right:auto;line-height:1.6;\">* The certificate fee covers the health check consultation. If your health does not permit the certificate to be issued, the consultation fee is non-refundable. The certificate is only issued and submitted to the Transport Administration if the health check results allow it.</p>\n\n <!-- Booking widget -->\n<section class=\"booking-section\" id=\"book\">\n <div class=\"container\">\n  <div class=\"booking-intro\">\n   <span class=\"overline\"></span>\n   <h2 class=\"section-title\" style=\"margin-bottom:8px;\">Book an appointment</h2>\n   <p class=\"section-lead\">Choose a convenient time below. No registration required to book.</p>\n  </div>\n  <div class=\"booking-note\">\n   Select service: <strong>\"Health check for motor vehicle driver's medical certificate \u2013 Category I\"</strong> (cat A/B/AM/T)\n   or <strong>\"\u2026Category II\"</strong> (cat C/D/E)\n  </div>\n  <div class=\"booking-widget-wrap\">\n   <p style=\"font-size:.9rem;color:var(--tellis);margin-bottom:1rem;line-height:1.6;\">In the booking system, select the service named <strong>\u00abTervisekontroll mootors\u00f5idukijuhi terviset\u00f5endi taotlemiseks I kategooria\u00bb</strong> (categories A/B) or <strong>\u00ab...II kategooria\u00bb</strong> (categories C/D/E). The service names are displayed in Estonian.</p>\n   <iframe\n    src=\"https://connectedserver.eu/ConnectedOnlineX/default.aspx?key=XxX0j1C0&lang=en\"\n    title=\"Book a health check appointment\"\n    allowfullscreen\n   ></iframe>\n  </div>\n  <p style=\"text-align:center; margin-top:16px; font-size:0.82rem; color:var(--kivi);\">\n   Questions? Call <a href=\"tel:+37259110909\" style=\"font-weight:600; color:var(--vein);\">+372 5911 0909</a> or email <a href=\"mailto:info@valvekliinik.ee\" style=\"color:var(--vein);\">info@valvekliinik.ee</a>\n  </p>\n </div>\n</section>\n\n<!-- FAQ -->\n<section class=\"section section-white\">\n <div class=\"container\">\n  <div class=\"section-head\">\n   <span class=\"overline\">Frequently asked questions</span>\n   <h2 class=\"section-title\">Answers to common questions</h2>\n  </div>\n  <div class=\"faq-list\">\n\n   <details class=\"faq-item\">\n    <summary>\n     Can I get the driving licence medical certificate the same day?\n     <span class=\"faq-icon\"></span>\n    </summary>\n    <div class=\"faq-body\">\n     Yes. If you have completed the health declaration in advance via <a href=\"https://www.terviseportaal.ee/\" target=\"_blank\" rel=\"noopener noreferrer\">terviseportaal.ee</a> (can also be done at the clinic) and no issues are found during the health check, the certificate is issued the same day. It is sent to the Transport Administration digitally.\n    </div>\n   </details>\n\n   <details class=\"faq-item\">\n    <summary>\n     Is a referral required?\n     <span class=\"faq-icon\"></span>\n    </summary>\n    <div class=\"faq-body\">\n     No, no referral is needed. Simply contact us directly \u2013 book online or call +372 5911 0909.\n    </div>\n   </details>\n\n   <details class=\"faq-item\">\n    <summary>\n     What is the health declaration and where do I complete it?\n     <span class=\"faq-icon\"></span>\n    </summary>\n    <div class=\"faq-body\">\n     The health declaration is the mandatory first step for applying for an e-health certificate. Complete it before your visit at <a href=\"https://www.terviseportaal.ee/\" target=\"_blank\" rel=\"noopener noreferrer\">terviseportaal.ee</a> using Smart-ID or your ID card. A certificate cannot be issued without a completed declaration.\n    </div>\n   </details>\n\n   <details class=\"faq-item\">\n    <summary>\n     How long does the driving licence health check take?\n     <span class=\"faq-icon\"></span>\n    </summary>\n    <div class=\"faq-body\">\n     The health check takes approximately 20\u201330 minutes. Including any waiting time, please allow around 30 minutes for the visit.\n    </div>\n   </details>\n\n   <details class=\"faq-item\">\n    <summary>\n     Do I need to come on an empty stomach?\n     <span class=\"faq-icon\"></span>\n    </summary>\n    <div class=\"faq-body\">\n     Yes. Please avoid eating for at least 2 hours before your appointment, as we measure blood glucose. Still water is fine.\n    </div>\n   </details>\n\n   <details class=\"faq-item\">\n    <summary>\n     What documents do I need to bring?\n     <span class=\"faq-icon\"></span>\n    </summary>\n    <div class=\"faq-body\">\n     Bring a valid identity document (ID card or passport) and your glasses or contact lenses if you normally wear them. The vision check is carried out with your corrective lenses on.\n    </div>\n   </details>\n\n   <details class=\"faq-item\">\n    <summary>\n     How often does the driving licence medical certificate need to be renewed?\n     <span class=\"faq-icon\"></span>\n    </summary>\n    <div class=\"faq-body\">\n     Category I (A, B, AM, T) \u2013 every 10 years for those under 65. Category II (C, D, E) \u2013 every 5 years. Drivers aged 65 and over must renew the certificate every 5 years for all categories.\n    </div>\n   </details>\n\n   <details class=\"faq-item\">\n    <summary>\n     Is the clinic open on Saturdays?\n     <span class=\"faq-icon\"></span>\n    </summary>\n    <div class=\"faq-body\">\n     Yes. We are open on Saturdays 12:00\u201316:00 and on public holidays 12:00\u201316:00. Monday to Friday we are open 9:00\u201318:00.\n    </div>\n   </details>\n\n   <details class=\"faq-item\">\n    <summary>\n     Where is the certificate sent?\n     <span class=\"faq-icon\"></span>\n    </summary>\n    <div class=\"faq-body\">\n     The certificate is issued digitally and sent automatically to the vehicle register. You do not need to submit anything separately \u2013 everything is handled electronically immediately after the certificate is issued.\n    </div>\n   </details>\n\n   <details class=\"faq-item\">\n    <summary>\n     What happens if a health issue is found during the check?\n     <span class=\"faq-icon\"></span>\n    </summary>\n    <div class=\"faq-body\">\n     If the health check reveals that the certificate cannot be issued, we will inform you accordingly. The consultation fee is non-refundable, as the health check has been carried out. In such cases, we can advise you on next steps.\n    </div>\n   </details>\n\n   <details class=\"faq-item\">\n    <summary>\n     Can I pay by card?\n     <span class=\"faq-icon\"></span>\n    </summary>\n    <div class=\"faq-body\">\n     Yes, payment is accepted on-site by card or in cash.\n    </div>\n   </details>\n\n  </div>\n </div>\n</section>\n\n<!-- CTA bottom -->\n<section class=\"cta-bottom\">\n <div class=\"container\">\n  <h2>Ready to get your driving licence certificate?</h2>\n  <p>Book an appointment and get your certificate today.</p>\n  <a href=\"#book\" class=\"btn-white\">Book an appointment</a>\n </div>\n</section>\n\n<!-- Footer -->\n<footer class=\"site-footer\">\n <div class=\"container\">\n  <div class=\"footer-inner\">\n   <div class=\"footer-col\">\n    <strong>Valvekliinik O\u00dc</strong>\n    <div class=\"footer-line\">Sepapaja 12/1, 3rd floor</div>\n    <div class=\"footer-line\">11415 Tallinn</div>\n    <div class=\"footer-line\" style=\"margin-top:4px;\">\u00dclemiste Tervisemaja 2 (von Baer building)</div>\n    <div class=\"footer-line\">\u00dclemiste City</div>\n   </div>\n   <div class=\"footer-col\">\n    <strong>Opening hours</strong>\n    <div class=\"footer-line\">Mon\u2013Fri 9:00\u201318:00</div>\n    <div class=\"footer-line\">Sat 12:00\u201316:00</div>\n    <div class=\"footer-line\">Public holidays 12:00\u201316:00</div>\n    <div class=\"footer-line\">Closed on Sundays</div>\n   </div>\n   <div class=\"footer-col\">\n    <strong>Contact</strong>\n    <div class=\"footer-line\"><a href=\"tel:+37259110909\">+372 5911 0909</a></div>\n    <div class=\"footer-line\"><a href=\"mailto:info@valvekliinik.ee\">info@valvekliinik.ee</a></div>\n    <div class=\"footer-line\" style=\"margin-top:4px;\"><a href=\"https://valvekliinik.ee\" target=\"_blank\" rel=\"noopener noreferrer\">valvekliinik.ee</a></div>\n    <div class=\"footer-line\">Reg no 11576944</div>\n   </div>\n  </div>\n </div>\n</footer>\n\n<!-- Schema.org JSON-LD -->\n<script type=\"application/ld+json\">\n{\n \